diff -ru a/src/geometry/transform/cross_time.rs b/src/geometry/transform/cross_time.rs
--- a/src/geometry/transform/cross_time.rs
+++ b/src/geometry/transform/cross_time.rs
@@ -0,0 +1,93 @@
+//! The answer of a cross-time lookup.
+
+use crate::{
+    geometry::{Quaternion, Vector3},
+    time::{TimePoint, Timestamp},
+};
+use alloc::string::String;
+
+/// Maps coordinates of the source frame at the source time into the target
+/// frame at the target time.
+///
+/// Returned by [`Registry::get_transform_at`](crate::Registry::get_transform_at)
+/// and built nowhere else. It holds at two instants, so it is deliberately
+/// not a [`Transform`](crate::geometry::Transform): it cannot be composed,
+/// inverted, serialized, or inserted into a registry, each of which would
+/// treat it as holding at one. Read the components and apply them to
+/// source-time coordinates — rotate, then translate — labeling the output
+/// with [`target_frame`](Self::target_frame) and
+/// [`target_time`](Self::target_time).
+///
+/// `==` is exact and compares both frames, both instants, and the geometry.
+#[derive(Debug, Clone, PartialEq)]
+pub struct CrossTimeTransform<T = Timestamp>
+where
+    T: TimePoint,
+{
+    target_frame: String,
+    target_time: T,
+    source_frame: String,
+    source_time: T,
+    translation: Vector3,
+    rotation: Quaternion,
+}
+
+impl<T> CrossTimeTransform<T>
+where
+    T: TimePoint,
+{
+    pub(crate) fn new(
+        target_frame: String,
+        target_time: T,
+        source_frame: String,
+        source_time: T,
+        translation: Vector3,
+        rotation: Quaternion,
+    ) -> Self {
+        Self {
+            target_frame,
+            target_time,
+            source_frame,
+            source_time,
+            translation,
+            rotation,
+        }
+    }
+
+    /// The frame the output coordinates are expressed in.
+    #[must_use]
+    pub fn target_frame(&self) -> &str {
+        &self.target_frame
+    }
+
+    /// The instant at which the output coordinates hold in the target frame.
+    #[must_use]
+    pub fn target_time(&self) -> T {
+        self.target_time
+    }
+
+    /// The frame the input coordinates are expressed in.
+    #[must_use]
+    pub fn source_frame(&self) -> &str {
+        &self.source_frame
+    }
+
+    /// The instant at which the input coordinates were expressed in the
+    /// source frame.
+    #[must_use]
+    pub fn source_time(&self) -> T {
+        self.source_time
+    }
+
+    /// The translational component, applied after the rotation.
+    #[must_use]
+    pub fn translation(&self) -> Vector3 {
+        self.translation
+    }
+
+    /// The rotational component, applied first.
+    #[must_use]
+    pub fn rotation(&self) -> Quaternion {
+        self.rotation
+    }
+}
