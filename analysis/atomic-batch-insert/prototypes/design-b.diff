@@ -0,0 +1,150 @@
+//! Staged, all-or-nothing inserts into a [`Registry`].
+
+use super::{Registry, RegistryError};
+use crate::{core::Buffer, geometry::Transform, time::TimePoint};
+use alloc::{string::String, vec::Vec};
+use hashbrown::HashMap;
+
+/// A set of inserts staged against a [`Registry`] and applied together.
+///
+/// [`Transaction::add_transform`] runs every check
+/// [`Registry::add_transform`] runs — against the registry as it stands plus
+/// whatever this transaction already staged — and stages the transform only
+/// if they all pass. A rejected transform is not staged and the transaction
+/// stays usable, so the caller picks the policy per item: `?` aborts, and
+/// dropping the transaction then leaves the registry untouched; ignoring the
+/// error skips that item and keeps the rest. [`Transaction::commit`] applies
+/// everything staged and cannot fail.
+///
+/// The transaction borrows the registry mutably for its whole life, so no
+/// frame can be added, removed or reparented behind its back: what passed
+/// the checks at staging time still passes at commit time. Staging a
+/// transform changes no lookup result until the commit.
+///
+/// Committing gives exactly the state that calling
+/// [`Registry::add_transform`] on the accepted transforms, in order, would
+/// have — including `max_age` eviction.
+///
+/// # Examples
+///
+/// All-or-nothing: the first rejection aborts and nothing is applied.
+///
+/// ```
+/// use transforms::{
+///     Registry,
+///     geometry::{Quaternion, Transform, Vector3},
+///     time::{Stamp, Timestamp},
+/// };
+///
+/// let at = Timestamp::zero();
+/// let tf = |parent: &str, child: &str| {
+///     Transform::new(
+///         parent,
+///         child,
+///         Vector3::zero(),
+///         Quaternion::identity(),
+///         Stamp::At(at),
+///     )
+///     .unwrap()
+/// };
+///
+/// let mut registry = Registry::new();
+/// let mut tx = registry.transaction();
+/// let result = (|| {
+///     tx.add_transform(tf("map", "odom"))?;
+///     tx.add_transform(tf("odom", "map"))?; // closes a cycle
+///     tx.add_transform(tf("odom", "base"))
+/// })();
+/// assert!(result.is_err());
+/// drop(tx);
+/// assert!(registry.get_transform("map", "odom", at).is_err()); // nothing applied
+/// ```
+///
+/// Skip bad items: a rejected transform is left out, the rest is applied.
+///
+/// ```
+/// # use transforms::{Registry, geometry::{Quaternion, Transform, Vector3}, time::{Stamp, Timestamp}};
+/// # let at = Timestamp::zero();
+/// # let tf = |parent: &str, child: &str| {
+/// #     Transform::new(parent, child, Vector3::zero(), Quaternion::identity(), Stamp::At(at)).unwrap()
+/// # };
+/// let mut registry = Registry::new();
+/// let mut tx = registry.transaction();
+/// let mut rejected = 0;
+/// for t in [tf("map", "odom"), tf("odom", "map"), tf("odom", "base")] {
+///     if tx.add_transform(t).is_err() {
+///         rejected += 1;
+///     }
+/// }
+/// tx.commit();
+/// assert_eq!(rejected, 1);
+/// assert!(registry.get_transform("map", "base", at).is_ok());
+/// ```
+#[derive(Debug)]
+#[must_use = "a transaction changes nothing until it is committed"]
+pub struct Transaction<'a, T>
+where
+    T: TimePoint,
+{
+    pub(super) registry: &'a mut Registry<T>,
+    /// Accepted transforms for frames the registry already holds, in order.
+    /// Inserts never change an existing buffer's parent or kind, so the
+    /// check that accepted each one holds until the commit.
+    pub(super) existing: Vec<Transform<T>>,
+    /// Frames created by this transaction, as real buffers that already hold
+    /// their accepted transforms.
+    pub(super) staged: HashMap<String, Buffer<T>>,
+}
+
+impl<T> Transaction<'_, T>
+where
+    T: TimePoint,
+{
+    /// Stages a transform after the checks [`Registry::add_transform`] runs.
+    ///
+    /// A rejected transform is not staged. The error is the one
+    /// [`Registry::add_transform`] would report for it at this point of the
+    /// sequence, and it does not name the transform that caused it: attribute
+    /// it by calling this once per transform.
+    ///
+    /// # Errors
+    ///
+    /// The same as [`Registry::add_transform`].
+    pub fn add_transform(
+        &mut self,
+        t: Transform<T>,
+    ) -> Result<(), RegistryError<T>> {
+        if let Some(buffer) = self.registry.data.get(t.child()) {
+            buffer.check(&t)?;
+            self.existing.push(t);
+        } else if let Some(buffer) = self.staged.get_mut(t.child()) {
+            buffer.insert(t)?;
+        } else {
+            let data = &self.registry.data;
+            let staged = &self.staged;
+            if Registry::<T>::creates_cycle(t.child(), t.parent(), |frame| {
+                data.get(frame)
+                    .or_else(|| staged.get(frame))
+                    .and_then(Buffer::parent)
+            }) {
+                return Err(RegistryError::CycleDetected);
+            }
+            let mut buffer = Registry::new_buffer(&t, self.registry.max_age);
+            let child: String = t.child().into();
+            buffer.insert(t)?;
+            self.staged.insert(child, buffer);
+        }
+        Ok(())
+    }
+
+    /// Applies everything staged. Cannot fail: every transform was checked
+    /// when it was staged.
+    pub fn commit(self) {
+        for t in self.existing {
+            if let Some(buffer) = self.registry.data.get_mut(t.child()) {
+                buffer.commit(t);
+            }
+        }
+        self.registry.data.extend(self.staged);
+    }
+}
