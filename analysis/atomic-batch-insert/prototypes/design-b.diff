index c2aa6c4..6fe2860 100644
--- a/tests/properties.rs
+++ b/tests/properties.rs
@@ -675,3 +675,159 @@ proptest! {
         }
     }
 }
+
+/// Frames for the transaction properties: few enough that random batches
+/// collide on parents, kinds and cycles constantly.
+const TX_FRAMES: [&str; 5] = ["a", "b", "c", "d", "e"];
+
+/// One batch item: an edge between two of [`TX_FRAMES`], static or stamped.
+/// `overflowing` builds the edge as the composition of two huge translations
+/// instead — a derived transform that no constructor validated, which only
+/// the insert check rejects.
+#[derive(Debug, Clone)]
+struct TxOp {
+    parent: usize,
+    child: usize,
+    is_static: bool,
+    nanos: u64,
+    x: f64,
+    overflowing: bool,
+}
+
+fn tx_ops() -> impl Strategy<Value = TxOp> {
+    (
+        0..TX_FRAMES.len(),
+        0..TX_FRAMES.len(),
+        prop::bool::weighted(0.25),
+        0_u64..8,
+        -10.0..10.0_f64,
+        prop::bool::weighted(0.05),
+    )
+        .prop_map(|(parent, child, is_static, nanos, x, overflowing)| TxOp {
+            parent,
+            child,
+            is_static,
+            nanos,
+            x,
+            overflowing,
+        })
+}
+
+fn tx_transform(op: &TxOp) -> Transform {
+    let stamp = if op.is_static {
+        Stamp::Static
+    } else {
+        Stamp::At(Timestamp::from_nanos(op.nanos))
+    };
+    let (parent, child) = (TX_FRAMES[op.parent], TX_FRAMES[op.child]);
+    if op.overflowing {
+        let huge = Vector3::new(1.7e308, 0.0, 0.0);
+        let up = Transform::new(parent, "via", huge, Quaternion::identity(), stamp).unwrap();
+        let down = Transform::new("via", child, huge, Quaternion::identity(), stamp).unwrap();
+        (up * down).unwrap()
+    } else {
+        Transform::new(
+            parent,
+            child,
+            Vector3::new(op.x, 0.0, 0.0),
+            Quaternion::identity(),
+            stamp,
+        )
+        .unwrap()
+    }
+}
+
+/// Everything observable about a registry through lookups, as comparable text.
+fn tx_snapshot(registry: &Registry) -> Vec<String> {
+    let mut out = Vec::new();
+    for a in TX_FRAMES {
+        for b in TX_FRAMES {
+            out.push(format!("{:?}", registry.latest_common_time(a, b)));
+            for nanos in 0..9 {
+                out.push(format!(
+                    "{:?}",
+                    registry.get_transform(a, b, Timestamp::from_nanos(nanos))
+                ));
+            }
+        }
+    }
+    out
+}
+
+fn tx_registry(
+    max_age: Option<u64>,
+    seed: &[TxOp],
+) -> Registry {
+    let mut registry = max_age.map_or_else(Registry::new, |nanos| {
+        Registry::with_max_age(core::time::Duration::from_nanos(nanos))
+    });
+    for op in seed.iter().filter(|op| !op.overflowing) {
+        let _ = registry.add_transform(tx_transform(op));
+    }
+    registry
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig { cases: 4096, ..ProptestConfig::default() })]
+
+    /// With `?` semantics a transaction is the `add_transform` loop made
+    /// atomic: the same first error, an untouched registry when it aborts,
+    /// and the loop's exact state when it commits.
+    #[test]
+    fn transaction_with_question_mark_semantics_equals_the_add_transform_loop(
+        max_age in prop::option::of(0_u64..4),
+        seed in prop::collection::vec(tx_ops(), 0..10),
+        batch in prop::collection::vec(tx_ops(), 0..7),
+    ) {
+        let mut looped = tx_registry(max_age, &seed);
+        let mut transacted = tx_registry(max_age, &seed);
+        let before = tx_snapshot(&transacted);
+
+        let mut expected = Ok(());
+        for op in &batch {
+            if let Err(error) = looped.add_transform(tx_transform(op)) {
+                expected = Err(error);
+                break;
+            }
+        }
+
+        let mut tx = transacted.transaction();
+        let got = batch.iter().try_for_each(|op| tx.add_transform(tx_transform(op)));
+        prop_assert_eq!(format!("{got:?}"), format!("{expected:?}"));
+        if got.is_ok() {
+            tx.commit();
+            prop_assert_eq!(tx_snapshot(&transacted), tx_snapshot(&looped));
+        } else {
+            drop(tx);
+            prop_assert_eq!(tx_snapshot(&transacted), before);
+        }
+    }
+
+    /// Skipping rejected items, a transaction equals the loop that ignores
+    /// errors: every item gets the loop's verdict, and the commit leaves the
+    /// loop's state.
+    #[test]
+    fn transaction_skipping_rejected_items_equals_the_loop_that_ignores_errors(
+        max_age in prop::option::of(0_u64..4),
+        seed in prop::collection::vec(tx_ops(), 0..10),
+        batch in prop::collection::vec(tx_ops(), 0..7),
+    ) {
+        let mut looped = tx_registry(max_age, &seed);
+        let mut transacted = tx_registry(max_age, &seed);
+
+        let expected: Vec<String> = batch
+            .iter()
+            .map(|op| format!("{:?}", looped.add_transform(tx_transform(op))))
+            .collect();
+
+        let mut tx = transacted.transaction();
+        let got: Vec<String> = batch
+            .iter()
+            .map(|op| format!("{:?}", tx.add_transform(tx_transform(op))))
+            .collect();
+        tx.commit();
+
+        prop_assert_eq!(got, expected);
+        prop_assert_eq!(tx_snapshot(&transacted), tx_snapshot(&looped));
+    }
+}
