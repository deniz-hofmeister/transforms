+
+/// One op of the batch-equivalence property: a link between two of a few
+/// frames, static or dynamic, optionally an overflowed (derived) translation
+/// that insertion must refuse.
+#[derive(Debug, Clone)]
+struct BatchOp {
+    parent: usize,
+    child: usize,
+    stat: bool,
+    nanos: u64,
+    x: f64,
+    overflowed: bool,
+}
+
+fn batch_ops() -> impl Strategy<Value = BatchOp> {
+    (
+        0..5_usize,
+        0..5_usize,
+        prop::bool::weighted(0.25),
+        0..8_u64,
+        -10.0..10.0_f64,
+        prop::bool::weighted(0.05),
+    )
+        .prop_map(|(parent, child, stat, nanos, x, overflowed)| BatchOp {
+            parent,
+            child,
+            stat,
+            nanos,
+            x,
+            overflowed,
+        })
+}
+
+fn batch_transform(op: &BatchOp) -> Transform<Timestamp> {
+    let names = ["a", "b", "c", "d", "e"];
+    let (parent, child) = (names[op.parent], names[op.child]);
+    let stamp = if op.stat {
+        Stamp::Static
+    } else {
+        Stamp::At(Timestamp::from_nanos(op.nanos))
+    };
+    if op.overflowed {
+        // Composition does not re-validate, so this is a transform with an
+        // infinite translation: only insertion can refuse it.
+        let first = Transform::new(
+            parent,
+            "via",
+            Vector3::new(1.7e308, 0.0, 0.0),
+            Quaternion::identity(),
+            stamp,
+        )
+        .unwrap();
+        let second = Transform::new(
+            "via",
+            child,
+            Vector3::new(1.7e308, 0.0, 0.0),
+            Quaternion::identity(),
+            stamp,
+        )
+        .unwrap();
+        (first * second).unwrap()
+    } else {
+        Transform::new(
+            parent,
+            child,
+            Vector3::new(op.x, 0.0, 0.0),
+            Quaternion::identity(),
+            stamp,
+        )
+        .unwrap()
+    }
+}
+
+/// Everything the registry answers about the fixture frames, as text.
+fn observable_state(registry: &Registry) -> Vec<String> {
+    let names = ["a", "b", "c", "d", "e"];
+    let mut out = Vec::new();
+    for target in names {
+        for source in names {
+            out.push(format!("{:?}", registry.latest_common_time(target, source)));
+            for nanos in 0..9 {
+                out.push(format!(
+                    "{:?}",
+                    registry.get_transform(target, source, Timestamp::from_nanos(nanos))
+                ));
+            }
+        }
+    }
+    out
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig::with_cases(2_000))]
+
+    #[test]
+    fn add_transforms_equals_the_add_transform_loop_or_changes_nothing(
+        max_age in proptest::option::of(0..4_u64),
+        seed in proptest::collection::vec(batch_ops(), 0..10),
+        batch in proptest::collection::vec(batch_ops(), 0..7),
+    ) {
+        let fresh = || match max_age {
+            Some(nanos) => Registry::with_max_age(core::time::Duration::from_nanos(nanos)),
+            None => Registry::new(),
+        };
+        let (mut looped, mut batched) = (fresh(), fresh());
+        for op in seed.iter().filter(|op| !op.overflowed) {
+            let _ = looped.add_transform(batch_transform(op));
+            let _ = batched.add_transform(batch_transform(op));
+        }
+        let before = observable_state(&batched);
+
+        let mut expected = Ok(());
+        for op in &batch {
+            if let Err(error) = looped.add_transform(batch_transform(op)) {
+                expected = Err(error);
+                break;
+            }
+        }
+        let actual = batched.add_transforms(batch.iter().map(batch_transform));
+
+        prop_assert_eq!(format!("{actual:?}"), format!("{expected:?}"));
+        if actual.is_ok() {
+            prop_assert_eq!(observable_state(&batched), observable_state(&looped));
+        } else {
+            prop_assert_eq!(observable_state(&batched), before);
+        }
+    }
+}
