+    /// Inserts a batch of transforms all-or-nothing.
+    ///
+    /// Equivalent to calling [`Registry::add_transform`] for each transform in
+    /// order, except that a failure leaves the registry exactly as it was:
+    /// no frame is created, no sample stored or replaced, no expired sample
+    /// evicted. On success the registry is the one the loop would have
+    /// produced, so a transform may use as parent a frame an earlier one in
+    /// the same batch creates, and the cycle check sees those edges.
+    /// Later transforms in a batch overwrite earlier ones the way repeated
+    /// inserts do: last write wins. An empty batch changes nothing.
+    ///
+    /// The batch is consumed before anything is stored, so an iterator that
+    /// never ends never returns. The error does not say which transform
+    /// caused it; check a suspect with [`Registry::add_transform`] on a
+    /// registry you can afford to change.
+    ///
+    /// # Errors
+    ///
+    /// The first error [`Registry::add_transform`] would report inserting the
+    /// batch in order, with the same variants and payloads, computed against
+    /// the registry as the preceding transforms of the batch would leave it:
+    ///
+    /// - [`RegistryError::NonFiniteValues`] or [`RegistryError::NonUnitRotation`]
+    ///   if a transform fails numeric validation.
+    /// - [`RegistryError::StaticDynamicConflict`] if a child's kind differs,
+    ///   from the registry or from an earlier transform of the batch.
+    /// - [`RegistryError::SelfReferentialFrame`] if parent equals child.
+    /// - [`RegistryError::ReparentingNotSupported`] if a child's parent
+    ///   differs from the one pinned.
+    /// - [`RegistryError::CycleDetected`] if a new edge would close a cycle.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use transforms::{
+    ///     Registry,
+    ///     errors::RegistryError,
+    ///     geometry::{Quaternion, Transform, Vector3},
+    ///     time::{Stamp, Timestamp},
+    /// };
+    ///
+    /// let stamp = Stamp::At(Timestamp::zero());
+    /// let link = |parent: &str, child: &str| {
+    ///     Transform::new(
+    ///         parent,
+    ///         child,
+    ///         Vector3::new(1.0, 0.0, 0.0),
+    ///         Quaternion::identity(),
+    ///         stamp,
+    ///     )
+    ///     .unwrap()
+    /// };
+    ///
+    /// let mut registry = Registry::new();
+    /// // `base` is created by the batch and used as a parent by the batch.
+    /// registry
+    ///     .add_transforms([link("map", "base"), link("base", "lidar")])
+    ///     .unwrap();
+    /// assert!(
+    ///     registry
+    ///         .get_transform("map", "lidar", Timestamp::zero())
+    ///         .is_ok()
+    /// );
+    ///
+    /// // The second transform would close a cycle, so the first is not stored.
+    /// let result = registry.add_transforms([link("lidar", "camera"), link("camera", "map")]);
+    /// assert!(matches!(result, Err(RegistryError::CycleDetected)));
+    /// assert!(
+    ///     registry
+    ///         .get_transform("lidar", "camera", Timestamp::zero())
+    ///         .is_err()
+    /// );
+    /// ```
+    pub fn add_transforms(
+        &mut self,
+        transforms: impl IntoIterator<Item = Transform<T>>,
+    ) -> Result<(), RegistryError<T>> {
+        // Every buffer the batch touches moves out of the map into `touched`
+        // and is moved back before returning, so nothing is cloned and no
+        // later lookup by name can miss: the apply step walks what it owns.
+        let mut touched: HashMap<String, Touched<T>> = HashMap::new();
+        let staged = self.stage(transforms, &mut touched);
+        let mut outcome = staged;
+        for (child, touch) in touched {
+            let Touched {
+                mut buffer,
+                pending,
+                created,
+            } = touch;
+            if outcome.is_ok() {
+                // Cannot fail for tokens checked against this very buffer;
+                // an error here is reported, never swallowed.
+                for checked in pending {
+                    if let Err(error) = buffer.commit(checked) {
+                        outcome = Err(error.into());
+                        break;
+                    }
+                }
+            }
+            if !created || outcome.is_ok() {
+                self.data.insert(child, buffer);
+            }
+        }
