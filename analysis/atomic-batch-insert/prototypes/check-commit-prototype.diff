+    /// Inserts a batch of transforms all-or-nothing.
+    ///
+    /// # Errors
+    ///
+    /// The first error [`Registry::add_transform`] would report inserting the
+    /// batch in order; the registry is then unchanged.
+    pub fn add_transforms(
+        &mut self,
+        transforms: impl IntoIterator<Item = Transform<T>>,
+    ) -> Result<(), RegistryError<T>> {
+        // Inserts never change an existing buffer's pins or kind, so its
+        // checks hold for the whole batch; new frames are built aside.
+        let mut existing = Vec::new();
+        let mut staged: HashMap<String, Buffer<T>> = HashMap::new();
+        for t in transforms {
+            if let Some(buffer) = self.data.get(t.child()) {
+                buffer.check(&t)?;
+                existing.push(t);
+            } else if let Some(buffer) = staged.get_mut(t.child()) {
+                buffer.insert(t)?;
+            } else {
+                if Self::creates_cycle(t.child(), t.parent(), |frame| {
+                    self.data
+                        .get(frame)
+                        .or_else(|| staged.get(frame))
+                        .and_then(Buffer::parent)
+                }) {
+                    return Err(RegistryError::CycleDetected);
+                }
+                let mut buffer = Self::new_buffer(&t, self.max_age);
+                let child: String = t.child().into();
+                buffer.insert(t)?;
+                staged.insert(child, buffer);
+            }
+        }
+        for t in existing {
+            if let Some(buffer) = self.data.get_mut(t.child()) {
+                buffer.commit(t);
+            }
+        }
+        self.data.extend(staged);
+        Ok(())
+    }
