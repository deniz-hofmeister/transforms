+    /// Reports the first error [`Registry::add_transform`] would return if
+    /// `transforms` were inserted in order, without changing the registry.
+    ///
+    /// Earlier items count: a later item may fail because an earlier one
+    /// pinned a frame's parent or kind, or closed the cycle it would close.
+    /// When this returns `Ok`, adding the same items in the same order, with
+    /// no other change to the registry in between, cannot fail. Holding
+    /// `&mut Registry` (or a write guard) across the check and the adds is
+    /// what provides that; a check under one guard and the adds under another
+    /// proves nothing about the second, and a writer in between can make an
+    /// add fail after earlier ones were applied.
+    ///
+    /// The error carries no position: it is the error of the first failing
+    /// item, not a name for it.
+    ///
+    /// # Errors
+    ///
+    /// The same variants, in the same order of precedence, as
+    /// [`Registry::add_transform`].
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use transforms::{
+    ///     Registry,
+    ///     geometry::{Quaternion, Transform, Vector3},
+    ///     time::{Stamp, Timestamp},
+    /// };
+    ///
+    /// let stamp = Stamp::At(Timestamp::zero());
+    /// let make = |parent, child| {
+    ///     Transform::new(
+    ///         parent,
+    ///         child,
+    ///         Vector3::zero(),
+    ///         Quaternion::identity(),
+    ///         stamp,
+    ///     )
+    ///     .unwrap()
+    /// };
+    /// let mut registry = Registry::new();
+    ///
+    /// let batch = [make("map", "odom"), make("odom", "base")];
+    /// registry.check_transforms(&batch).unwrap();
+    /// for t in batch {
+    ///     registry.add_transform(t).unwrap();
+    /// }
+    ///
+    /// // Closing the loop fails the check; nothing was inserted.
+    /// let cyclic = [make("base", "map")];
+    /// assert!(registry.check_transforms(&cyclic).is_err());
+    /// ```
+    pub fn check_transforms<'a>(
+        &self,
+        transforms: impl IntoIterator<Item = &'a Transform<T>>,
+    ) -> Result<(), RegistryError<T>>
+    where
+        T: 'a,
+    {
+        // Inserts never change an existing buffer's pins or kind, so each
+        // existing frame is checked against the registry as it stands. New
+        // frames are staged as empty buffers holding only their pins and
+        // kind: enough for later items to be checked against them and for
+        // the cycle walk to cross them, with no sample stored.
+        let mut staged: HashMap<&str, Buffer<T>> = HashMap::new();
+        for t in transforms {
+            if let Some(buffer) = self.data.get(t.child()) {
+                buffer.check(t)?;
+            } else if let Some(buffer) = staged.get(t.child()) {
+                buffer.check(t)?;
+            } else {
+                if Self::creates_cycle(t.child(), t.parent(), |frame| {
+                    self.data
+                        .get(frame)
+                        .or_else(|| staged.get(frame))
+                        .and_then(Buffer::parent)
+                }) {
+                    return Err(RegistryError::CycleDetected);
+                }
+                let mut buffer = Self::new_buffer(t, self.max_age);
+                buffer.check(t)?;
+                buffer.pin(t);
+                staged.insert(t.child(), buffer);
+            }
+        }
+        Ok(())
+    }
+
