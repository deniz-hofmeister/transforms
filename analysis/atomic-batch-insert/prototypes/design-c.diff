+
+    #[test]
+    fn check_transforms_passes_a_batch_whose_later_items_depend_on_earlier_ones() {
+        let registry = Registry::new();
+        let t = Stamp::At(Timestamp::from_nanos(1));
+        let batch = [
+            translated("a", "b", t, 1.0),
+            translated("b", "c", t, 1.0),
+            translated("b", "c", t, 2.0),
+        ];
+        registry.check_transforms(&batch).unwrap();
+        assert!(matches!(
+            registry.get_transform("a", "b", Timestamp::from_nanos(1)),
+            Err(RegistryError::UnknownFrame(_))
+        ));
+    }
+
+    #[test]
+    fn check_transforms_sees_cycles_closed_by_earlier_batch_items() {
+        let registry = Registry::new();
+        let t = Stamp::At(Timestamp::from_nanos(1));
+        let batch = [
+            translated("a", "b", t, 1.0),
+            translated("b", "c", t, 1.0),
+            translated("c", "a", t, 1.0),
+        ];
+        assert!(matches!(
+            registry.check_transforms(&batch),
+            Err(RegistryError::CycleDetected)
+        ));
+    }
+
+    #[test]
+    fn check_transforms_sees_kind_pinned_by_earlier_batch_items() {
+        let registry = Registry::new();
+        let batch = [
+            translated("a", "b", Stamp::Static, 1.0),
+            translated("a", "b", Stamp::At(Timestamp::from_nanos(1)), 1.0),
+        ];
+        assert!(matches!(
+            registry.check_transforms(&batch),
+            Err(RegistryError::StaticDynamicConflict)
+        ));
+    }
+
+    #[test]
+    fn check_then_add_under_separate_guards_can_apply_a_batch_partially() {
+        // The check is a snapshot. A writer that lands between it and the
+        // adds invalidates it, and the add loop then fails after earlier
+        // items were applied: the all-or-nothing promise exists only while
+        // one `&mut` borrow (one write guard) spans both steps.
+        let mut registry = Registry::new();
+        let t = Stamp::At(Timestamp::from_nanos(1));
+        let batch = [translated("a", "b", t, 1.0), translated("c", "d", t, 1.0)];
+        registry.check_transforms(&batch).unwrap();
+
+        // Interleaved writer: pins "d" to a different parent.
+        registry
+            .add_transform(translated("x", "d", t, 5.0))
+            .unwrap();
+
+        let result: Result<(), _> = batch
+            .iter()
+            .cloned()
+            .try_for_each(|t| registry.add_transform(t));
+        assert!(matches!(
+            result,
+            Err(RegistryError::ReparentingNotSupported { .. })
+        ));
+        // "a -> b" was applied although the batch as a whole failed.
+        registry
+            .get_transform("a", "b", Timestamp::from_nanos(1))
+            .unwrap();
+    }
+
+    #[test]
+    fn check_then_add_under_one_borrow_never_applies_a_batch_partially() {
+        let mut registry = Registry::new();
+        let t = Stamp::At(Timestamp::from_nanos(1));
+        let batch = [translated("a", "b", t, 1.0), translated("b", "a", t, 1.0)];
+        // The check rejects, so the adds are never started.
+        assert!(registry.check_transforms(&batch).is_err());
+        assert!(
+            registry
+                .get_transform("a", "b", Timestamp::from_nanos(1))
+                .is_err()
+        );
+        registry.check_transforms(&batch[..1]).unwrap();
+        registry.add_transform(batch[0].clone()).unwrap();
+    }
 }
