index c2aa6c4..3484b53 100644
--- a/tests/properties.rs
+++ b/tests/properties.rs
@@ -675,3 +675,113 @@ proptest! {
         }
     }
 }
+
+/// Frames for the batch-check property: few enough that random batches
+/// collide on pins, kinds and cycles constantly.
+const BATCH_FRAMES: [&str; 5] = ["a", "b", "c", "d", "e"];
+
+/// One random insert: frames, kind, timestamp, and whether the value is a
+/// derived transform whose translation overflowed (rejected on insert, not
+/// by its constructor).
+#[derive(Debug, Clone)]
+struct BatchOp {
+    parent: usize,
+    child: usize,
+    is_static: bool,
+    nanos: u64,
+    overflowed: bool,
+}
+
+fn batch_ops() -> impl Strategy<Value = BatchOp> {
+    (
+        0..BATCH_FRAMES.len(),
+        0..BATCH_FRAMES.len(),
+        prop::bool::weighted(0.25),
+        0..8_u64,
+        prop::bool::weighted(0.05),
+    )
+        .prop_map(|(parent, child, is_static, nanos, overflowed)| BatchOp {
+            parent,
+            child,
+            is_static,
+            nanos,
+            overflowed,
+        })
+}
+
+/// Builds the op's transform; `None` where the constructor refuses it
+/// (parent equals child).
+fn batch_transform(op: &BatchOp) -> Option<Transform> {
+    let stamp = if op.is_static {
+        Stamp::Static
+    } else {
+        Stamp::At(Timestamp::from_nanos(op.nanos))
+    };
+    let (parent, child) = (BATCH_FRAMES[op.parent], BATCH_FRAMES[op.child]);
+    if op.overflowed {
+        let half = Vector3::new(1.7e308, 0.0, 0.0);
+        let first = Transform::new(parent, "via", half, Quaternion::identity(), stamp).ok()?;
+        let second = Transform::new("via", child, half, Quaternion::identity(), stamp).ok()?;
+        return (first * second).ok();
+    }
+    Transform::new(
+        parent,
+        child,
+        Vector3::new(1.0, 0.0, 0.0),
+        Quaternion::identity(),
+        stamp,
+    )
+    .ok()
+}
+
+/// Everything observable about a registry over the fixture frames.
+fn batch_snapshot(registry: &Registry) -> Vec<String> {
+    let mut out = Vec::new();
+    for a in BATCH_FRAMES {
+        for b in BATCH_FRAMES {
+            out.push(format!("{:?}", registry.latest_common_time(a, b)));
+            for nanos in 0..9 {
+                let at = Timestamp::from_nanos(nanos);
+                out.push(format!("{:?}", registry.get_transform(a, b, at)));
+            }
+        }
+    }
+    out
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig::with_cases(5_000))]
+
+    /// `check_transforms` agrees with the `add_transform` loop it predicts:
+    /// same first error, never mutating, and when it passes the loop cannot
+    /// fail.
+    #[test]
+    fn check_transforms_predicts_the_add_transform_loop(
+        max_age in prop::option::of(0..4_u64),
+        seed in prop::collection::vec(batch_ops(), 0..10),
+        batch in prop::collection::vec(batch_ops(), 0..7),
+    ) {
+        let new_registry = || match max_age {
+            Some(nanos) => Registry::with_max_age(core::time::Duration::from_nanos(nanos)),
+            None => Registry::new(),
+        };
+        let mut registry = new_registry();
+        for transform in seed.iter().filter(|op| !op.overflowed).filter_map(batch_transform) {
+            let _ = registry.add_transform(transform);
+        }
+        let batch: Vec<Transform> = batch.iter().filter_map(batch_transform).collect();
+
+        let before = batch_snapshot(&registry);
+        let checked = registry.check_transforms(&batch);
+        prop_assert_eq!(batch_snapshot(&registry), before);
+
+        let mut looped = Ok(());
+        for transform in batch {
+            if let Err(error) = registry.add_transform(transform) {
+                looped = Err(error);
+                break;
+            }
+        }
+        prop_assert_eq!(format!("{checked:?}"), format!("{looped:?}"));
+    }
+}
