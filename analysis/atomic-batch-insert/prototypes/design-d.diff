+//! A DimOS-style caller-side all-or-nothing batch built only on the public
+//! introspection queries (`Registry::parent`, `Registry::frame_kind`) and
+//! `Transform::validate`, checked against the `add_transform` loop it
+//! pre-validates for.
+
+use core::time::Duration;
+use proptest::prelude::*;
+use std::collections::HashMap;
+use transforms::{
+    FrameKind, Registry,
+    errors::RegistryError,
+    geometry::{Quaternion, Transform, Vector3},
+    time::{Stamp, Timestamp},
+};
+
+/// Returns the error the `add_transform` loop would hit first, without
+/// mutating `registry`.
+///
+/// Frames the batch itself introduces are tracked in `staged`: a later
+/// transform sees them exactly as the loop would after applying the earlier
+/// ones.
+fn validate_batch(
+    registry: &Registry,
+    batch: &[Transform<Timestamp>],
+) -> Result<(), RegistryError> {
+    let mut staged: HashMap<&str, (&str, FrameKind)> = HashMap::new();
+    let parent_of = |staged: &HashMap<&str, (&str, FrameKind)>, frame: &str| -> Option<String> {
+        staged
+            .get(frame)
+            .map(|&(parent, _)| parent.to_string())
+            .or_else(|| registry.parent(frame).map(str::to_string))
+    };
+    for t in batch {
+        let is_static = t.timestamp() == Stamp::Static;
+        let kind = if is_static {
+            FrameKind::Static
+        } else {
+            FrameKind::Dynamic
+        };
+        let existing = staged
+            .get(t.child())
+            .map(|&(parent, kind)| (parent.to_string(), kind))
+            .or_else(|| {
+                registry
+                    .parent(t.child())
+                    .zip(registry.frame_kind(t.child()))
+                    .map(|(parent, kind)| (parent.to_string(), kind))
+            });
+        if let Some((parent, existing_kind)) = existing {
+            t.validate()?;
+            if t.parent() == t.child() {
+                return Err(RegistryError::SelfReferentialFrame);
+            }
+            if parent != t.parent() {
+                return Err(RegistryError::ReparentingNotSupported {
+                    current_parent: parent,
+                });
+            }
+            if existing_kind != kind {
+                return Err(RegistryError::StaticDynamicConflict);
+            }
+        } else {
+            let mut current = t.parent().to_string();
+            while let Some(next) = parent_of(&staged, &current) {
+                if next == t.child() {
+                    return Err(RegistryError::CycleDetected);
+                }
+                current = next;
+            }
+            // The loop checks the cycle before the buffer validates.
+            t.validate()?;
+            if t.parent() == t.child() {
+                return Err(RegistryError::SelfReferentialFrame);
+            }
+            staged.insert(t.child(), (t.parent(), kind));
+        }
+    }
+    Ok(())
+}
+
+/// Validates, then applies: the caller-side all-or-nothing batch.
+fn apply_batch(
+    registry: &mut Registry,
+    batch: Vec<Transform<Timestamp>>,
+) -> Result<(), RegistryError> {
+    validate_batch(registry, &batch)?;
+    for t in batch {
+        registry.add_transform(t)?;
+    }
+    Ok(())
+}
+
+const FRAMES: [&str; 5] = ["a", "b", "c", "d", "e"];
+
+#[derive(Debug, Clone)]
+struct Op {
+    parent: usize,
+    child: usize,
+    stat: bool,
+    ns: u64,
+    x: f64,
+    bad: bool,
+}
+
+fn op() -> impl Strategy<Value = Op> {
+    (
+        0..5usize,
+        0..5usize,
+        prop::bool::weighted(0.25),
+        0..8u64,
+        -10.0..10.0f64,
+        prop::bool::weighted(0.05),
+    )
+        .prop_map(|(parent, child, stat, ns, x, bad)| Op {
+            parent,
+            child,
+            stat,
+            ns,
+            x,
+            bad,
+        })
+}
+
+fn stamp(o: &Op) -> Stamp<Timestamp> {
+    if o.stat {
+        Stamp::Static
+    } else {
+        Stamp::At(Timestamp::from_nanos(o.ns))
+    }
+}
+
+fn build(o: &Op) -> Transform<Timestamp> {
+    Transform::new(
+        FRAMES[o.parent],
+        FRAMES[o.child],
+        Vector3::new(o.x, 0.0, 0.0),
+        Quaternion::identity(),
+        stamp(o),
+    )
+    .unwrap()
+}
+
+/// A derived transform whose translation overflowed to infinity: not
+/// re-validated by composition, so only `validate` catches it.
+fn build_overflowed(o: &Op) -> Transform<Timestamp> {
+    let a = Transform::new(
+        FRAMES[o.parent],
+        "via",
+        Vector3::new(1.7e308, 0.0, 0.0),
+        Quaternion::identity(),
+        stamp(o),
+    )
+    .unwrap();
+    let b = Transform::new(
+        "via",
+        FRAMES[o.child],
+        Vector3::new(1.7e308, 0.0, 0.0),
+        Quaternion::identity(),
+        stamp(o),
+    )
+    .unwrap();
+    (a * b).unwrap()
+}
+
+fn make(o: &Op) -> Transform<Timestamp> {
+    if o.bad { build_overflowed(o) } else { build(o) }
+}
+
+fn snapshot(r: &Registry) -> Vec<String> {
+    let mut out = Vec::new();
+    for a in FRAMES {
+        out.push(format!("{:?} {:?}", r.parent(a), r.frame_kind(a)));
+        for b in FRAMES {
+            out.push(format!("{:?}", r.latest_common_time(a, b)));
+            for ns in 0..9 {
+                out.push(format!(
+                    "{:?}",
+                    r.get_transform(a, b, Timestamp::from_nanos(ns))
+                ));
+            }
+        }
+    }
+    out
+}
+
+fn fresh(max_age: Option<u64>) -> Registry {
+    match max_age {
+        Some(n) => Registry::with_max_age(Duration::from_nanos(n)),
+        None => Registry::new(),
+    }
+}
+
+struct Outcome {
+    /// The `add_transform` loop's first error.
+    expected: Result<(), RegistryError>,
+    /// The validator-gated batch's result.
+    got: Result<(), RegistryError>,
+    looped: Registry,
+    gated: Registry,
+    /// Snapshot of the gated registry before the batch.
+    before: Vec<String>,
+}
+
+/// Runs the plain loop on one registry and the validator-gated batch on another.
+fn run(
+    max_age: Option<u64>,
+    seed: &[Op],
+    batch: &[Op],
+) -> Outcome {
+    let mut looped = fresh(max_age);
+    let mut gated = fresh(max_age);
+    for o in seed.iter().filter(|o| !o.bad) {
+        let _ = looped.add_transform(build(o));
+        let _ = gated.add_transform(build(o));
+    }
+    let before = snapshot(&gated);
+    let mut expected = Ok(());
+    for o in batch {
+        if let Err(e) = looped.add_transform(make(o)) {
+            expected = Err(e);
+            break;
+        }
+    }
+    let got = apply_batch(&mut gated, batch.iter().map(make).collect());
+    Outcome {
+        expected,
+        got,
+        looped,
+        gated,
+        before,
+    }
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig::with_cases(20_000))]
+
+    /// Never a partial application, and the same accept/reject decision as
+    /// the loop's all-or-nothing semantics.
+    #[test]
+    fn gated_batch_never_partially_applies(
+        max_age in prop::option::of(0..4u64),
+        seed in prop::collection::vec(op(), 0..10),
+        batch in prop::collection::vec(op(), 0..7),
+    ) {
+        let o = run(max_age, &seed, &batch);
+        prop_assert_eq!(o.got.is_ok(), o.expected.is_ok());
+        if o.got.is_ok() {
+            prop_assert_eq!(snapshot(&o.gated), snapshot(&o.looped));
+        } else {
+            prop_assert_eq!(snapshot(&o.gated), o.before);
+        }
+    }
+
+    /// The gated batch also reports the loop's first error.
+    #[test]
+    fn gated_batch_reports_the_loops_first_error(
+        max_age in prop::option::of(0..4u64),
+        seed in prop::collection::vec(op(), 0..10),
+        batch in prop::collection::vec(op(), 0..7),
+    ) {
+        let o = run(max_age, &seed, &batch);
+        prop_assert_eq!(format!("{:?}", o.got), format!("{:?}", o.expected));
+    }
+}
